{
  "name": "toneperfect",
  "version": "0.3.0",
  "description": "Client for the TonePerfect pronunciation assessment API, 10 languages: sentence, word and sound scores, Mandarin initial/final/tone per syllable.",
  "license": "MIT",
  "author": "TonePerfect <nik@toneperfect.app>",
  "homepage": "https://api.toneperfect.app",
  "bugs": {
    "email": "nik@toneperfect.app"
  },
  "keywords": [
    "pronunciation",
    "pronunciation-assessment",
    "speech",
    "speech-assessment",
    "mandarin",
    "tones",
    "language-learning",
    "api",
    "sdk"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./rubric": {
      "types": "./rubric.d.ts",
      "default": "./rubric.cjs"
    }
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "rubric.cjs",
    "rubric.d.ts",
    "bin",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {},
  "bin": {
    "toneperfect-lint": "./bin/toneperfect-lint.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vm542/toneperfect-sdk.git",
    "directory": "node"
  }
}
